# Copy to .env (never commit it). Values here are read by app.config.ts and Metro.

# Maps SDK for Android key, restricted to pk.raahi.app + SHA-1 (D19). Not needed in Expo Go.
GOOGLE_MAPS_API_KEY=

# Phase 1 runs against the in-app mock API. Set to false once api/ is live.
EXPO_PUBLIC_USE_MOCK_API=true
EXPO_PUBLIC_API_URL=http://localhost:3000/v1
